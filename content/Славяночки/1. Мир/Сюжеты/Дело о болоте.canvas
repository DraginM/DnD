{
	"nodes":[
		{"id":"362bdff9cd7dfee4","type":"text","text":"[[Ждан]] заказал [[Родвид|Родвида]] для убийства","x":-415,"y":-215,"width":250,"height":70},
		{"id":"958dff233bfd042c","type":"text","text":"[[Родвид]] убивает волшебника","x":-380,"y":-80,"width":180,"height":60},
		{"id":"beaab1b72ac84711","type":"text","text":"[[Волшебник]] переспал с чьей-то женой Ядвигой","x":-120,"y":-340,"width":250,"height":60},
		{"id":"4376b6df40401f3b","type":"text","text":"[[Волшебник]] переезжает в болотную деревню","x":-120,"y":-80,"width":250,"height":60},
		{"id":"c8c4c1c4f17b329f","type":"text","text":"Тело волшебника переносят","x":-700,"y":-80,"width":250,"height":60},
		{"id":"1b829ff714cc7c7d","type":"text","text":"Тотемы распространяют проклятье дальше","x":-120,"y":65,"width":250,"height":60,"color":"5"},
		{"id":"ee79181260616e04","type":"text","text":"Обереги из тотемов имеют ту же структуру, но другие символы","x":-120,"y":210,"width":250,"height":100,"color":"5"},
		{"id":"ea9ae837bce190e9","type":"text","text":"[[Родвид]] был проклят (?)\n\"Ты заплатишь столько, сколько получил за эту работу\"","x":-415,"y":35,"width":250,"height":120},
		{"id":"0dc8e53cf565873e","type":"text","text":"Рыжая девушка учит [[Родвид|Родвида]] делать обереги из монет","x":-415,"y":215,"width":250,"height":90},
		{"id":"4bd58497ca98daae","type":"text","text":"Кто проклял [[Родвид|Родвида]]?\nЭто сделала свечница, в попытках остановить болото","x":-700,"y":35,"width":250,"height":120,"color":"4"},
		{"id":"dd309bdc793f8244","type":"text","text":"[[Волшебник]] заключает сделку с [[Хранитель|Хранителем]] на дополнительную силу","x":180,"y":-100,"width":250,"height":100,"color":"3"},
		{"id":"921ee6848c44c2ee","type":"text","text":"Контракт расширяет болота. Уставший Хранитель перекрыл реку","x":180,"y":35,"width":250,"height":120},
		{"id":"4ca8e587256cef18","type":"text","text":"Хранитель превращает умерших в деревья\n\"Это был единственный способ\"","x":180,"y":200,"width":250,"height":120,"color":"5"},
		{"id":"954e6bc97ef55f2c","type":"text","text":"Свечница Аглая из новой деревни.\nДочь волшебника (возможно)","x":-700,"y":202,"width":250,"height":117,"color":"5"},
		{"id":"0ff5d6eed86460e0","type":"text","text":"Свечница общается с сыном главы новой деревни","x":-700,"y":390,"width":250,"height":90,"color":"5"},
		{"id":"a01bdb413cc282aa","type":"text","text":"Глава новой деревни считает волшебника норм челом","x":-700,"y":590,"width":250,"height":100,"color":"5"},
		{"id":"e8d373811aebf65e","type":"text","text":"В новой деревне есть волшебники, что натворили фигни.\nОни пришли примерно с волшебником","x":-415,"y":560,"width":250,"height":160,"color":"5"},
		{"id":"f72b42ac6a4d410f","type":"text","text":"Обереги тотемов укрепляют контракт","x":-120,"y":401,"width":250,"height":60,"color":"5"},
		{"id":"46587a9b94673ab2","type":"text","text":"Глава деревни культист?\nНет, он не понимает ничего в магии","x":-980,"y":585,"width":250,"height":110,"color":"4"},
		{"id":"25f5a454d6bc8a8e","type":"text","text":"[[Ждан]], как староста, угрожает волшебнику","x":-127,"y":-215,"width":265,"height":70},
		{"id":"672df66659ff02eb","type":"text","text":"Контракт был переписан в пользу кого-то","x":480,"y":65,"width":250,"height":60,"color":"5"},
		{"id":"2835d2ec8db99a7a","type":"text","text":"[[Ждан|Ждана]] сняли с поста и изгоняют. Избирается новый староста","x":-700,"y":-235,"width":250,"height":110},
		{"id":"dab944f1d372cf15","type":"text","text":"Где старый хранитель?\nСбежал подальше от ответственности и забот","x":780,"y":-98,"width":250,"height":98,"color":"4"},
		{"id":"dbef254e9b10a88a","type":"text","text":"Тотемы:\nКладбище (х)\nРодвид (х)\nБолото (х)\nНовая деревня (х)\nХранитель (х)\nЛесопилка (х)","x":-415,"y":331,"width":250,"height":201,"color":"5"},
		{"id":"cb86255fc1101449","type":"text","text":"Записка написана от первого лица, но не волшебником (подчерк просто оч похож)","x":-980,"y":-111,"width":250,"height":123,"color":"5"},
		{"id":"5c927febc8ab94ba","type":"text","text":"Зачем Хранителю подписывать договор?\nСтарый хранитель надоумил нынешнего на подпись контракта","x":480,"y":-126,"width":250,"height":152,"color":"4"},
		{"id":"d526711945ea37b5","type":"text","text":"Хранитель раньше был человеком","x":480,"y":-235,"width":250,"height":60,"color":"5"}
	],
